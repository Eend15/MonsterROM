diff --git a/drivers/dma-buf/heaps/samsung/Kconfig b/drivers/dma-buf/heaps/samsung/Kconfig
index 3ba1d2ee9..78b74c4ca 100644
--- a/drivers/dma-buf/heaps/samsung/Kconfig
+++ b/drivers/dma-buf/heaps/samsung/Kconfig
@@ -11,6 +11,17 @@ config DMABUF_SAMSUNG_HEAPS
 	  This options creates per heap chardevs in /dev/dma_heap/* which allows
 	  userspace to allocate dma-bufs that can be shared between drivers.
 
+config DMABUF_HEAPS_ION_COMPAT
+	bool "Keep legacy Samsung ION clients with DMA-BUF system heaps"
+	depends on DMABUF_SAMSUNG_HEAPS && ION
+	select DMABUF_HEAPS_SAMSUNG_SYSTEM
+	help
+	  Enable the cached and uncached Samsung system DMA-BUF heaps while
+	  preserving ION for existing vendor HALs, camera, DSP and protected
+	  media. Reserved-memory and secure heaps remain owned exclusively by
+	  ION, avoiding duplicate carveout and secure-IOVA allocators.
+	  The dma_buf_env boot feature still controls the DMA-BUF system heaps.
+
 config DMABUF_HEAPS_SAMSUNG_CHUNK
 	bool "DMA-BUF CHUNK Samsung Heap"
 	help
