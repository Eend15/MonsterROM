Subject: [PATCH] Report 5.15.206 for the selected uname/BPF spoof

Keep the existing privileged BPF-loader caller gates and real kernel/module
release unchanged. Select CONFIG_FAKE_UNAME_5_15 with uname.config and update
both the reported workaround target and the newuname result consistently.

diff --git a/kernel/sys.c b/kernel/sys.c
--- a/kernel/sys.c
+++ b/kernel/sys.c
@@ -1261,7 +1261,7 @@ const char *get_bpf_spoof_version(void)
 #elif defined(CONFIG_FAKE_UNAME_5_10)
 	return "5.10.200";
 #elif defined(CONFIG_FAKE_UNAME_5_15)
-	return "5.15.200";
+	return "5.15.206";
 #elif defined(CONFIG_FAKE_UNAME_6_1)
 	return "6.1.200";
 #elif defined(CONFIG_FAKE_UNAME_6_6)
@@ -1590,7 +1590,7 @@ SYSCALL_DEFINE1(newuname, struct new_utsname __user *, name)
 #elif defined(CONFIG_FAKE_UNAME_5_10)
 			strcpy(tmp.release, "5.10.200");
 #elif defined(CONFIG_FAKE_UNAME_5_15)
-			strcpy(tmp.release, "5.15.200");
+			strcpy(tmp.release, "5.15.206");
 #elif defined(CONFIG_FAKE_UNAME_6_1)
 			strcpy(tmp.release, "6.1.200");
 #elif defined(CONFIG_FAKE_UNAME_6_6)
