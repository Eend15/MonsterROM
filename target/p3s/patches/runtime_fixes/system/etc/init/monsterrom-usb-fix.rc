on post-fs-data
    start monsterrom-usb-fix

on property:sys.boot_completed=1
    start monsterrom-usb-fix
    start monsterrom-display-fix

on property:vendor.boot_completed=1
    start monsterrom-usb-fix
    start monsterrom-display-fix

on property:persist.sys.usb.config=adb
    setprop persist.sys.usb.config mtp,adb
    setprop persist.vendor.usb.config mtp,adb
    setprop sys.usb.config mtp,adb

on property:persist.sys.usb.config=none
    setprop persist.sys.usb.config mtp
    setprop persist.vendor.usb.config mtp
    setprop sys.usb.config mtp

on property:persist.sys.usb.config=sec_charging
    setprop persist.sys.usb.config mtp
    setprop persist.vendor.usb.config mtp
    setprop sys.usb.config mtp

on property:persist.sys.usb.config=sec_charging,adb
    setprop persist.sys.usb.config mtp,adb
    setprop persist.vendor.usb.config mtp,adb
    setprop sys.usb.config mtp,adb

on property:sys.usb.config=adb
    setprop persist.sys.usb.config mtp,adb
    setprop persist.vendor.usb.config mtp,adb
    setprop sys.usb.config mtp,adb

on property:sys.usb.config=sec_charging
    setprop persist.sys.usb.config mtp
    setprop persist.vendor.usb.config mtp
    setprop sys.usb.config mtp

on property:sys.usb.config=sec_charging,adb
    setprop persist.sys.usb.config mtp,adb
    setprop persist.vendor.usb.config mtp,adb
    setprop sys.usb.config mtp,adb

on property:sys.boot_completed=1 && property:sys.usb.config=mtp,adb && property:sys.usb.ffs.ready=0
    start adbd
    write /config/usb_gadget/g1/UDC "none"
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_acm"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    rm /config/usb_gadget/g1/configs/b.1/f3
    rm /config/usb_gadget/g1/configs/b.1/f4
    rm /config/usb_gadget/g1/configs/b.1/f5
    rm /config/usb_gadget/g1/os_desc/b.1
    write /config/usb_gadget/g1/idVendor 0x04E8
    write /config/usb_gadget/g1/idProduct 0x6860
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/acm.gs6 /config/usb_gadget/g1/configs/b.1/f2
    symlink /config/usb_gadget/g1/functions/ss_mon.mtp /config/usb_gadget/g1/configs/b.1/f5
    symlink /config/usb_gadget/g1/configs/b.1 /config/usb_gadget/g1/os_desc/b.1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state mtp,adb

service monsterrom-usb-fix /system/bin/sh /system/bin/monsterrom-usb-fix.sh
    class late_start
    user root
    group root system shell
    disabled
    oneshot
    seclabel u:r:init:s0

service monsterrom-display-fix /system/bin/sh /system/bin/monsterrom-display-fix.sh
    class late_start
    user root
    group root system shell
    disabled
    oneshot
    seclabel u:r:init:s0
