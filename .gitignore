out/

# Local credentials and signing identities (tracked public test keys stay tracked).
.env
.env.*
security/*.pk8
security/*_platform.x509.pem
security/*_ota.x509.pem
*.p12
*.pfx
*.jks
*.keystore
__pycache__/
*.pyc

# Cert
security/unica_ota.x509.pem
security/unica_ota.pk8
security/unica_platform.x509.pem
security/unica_platform.pk8

#
# We don't want to ignore the following even if they are dot-files
#
!.gitattributes
!.gitignore
!.gitmodules
