From 164b9eaceac106fb3897b3d6ed3f16bd3af13708 Mon Sep 17 00:00:00 2001
From: ditternation <ditternation@outlook.com>
Date: Sat, 28 Mar 2026 10:56:32 +0100
Subject: [PATCH] Allow app target SDK bypass

---
 .../server/pm/InstallPackageHelper.smali      | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/smali_classes2/com/android/server/pm/InstallPackageHelper.smali b/smali_classes2/com/android/server/pm/InstallPackageHelper.smali
index 455221a..b2f0db1 100644
--- a/smali_classes2/com/android/server/pm/InstallPackageHelper.smali
+++ b/smali_classes2/com/android/server/pm/InstallPackageHelper.smali
@@ -15627,6 +15627,23 @@
     :cond_17
     if-nez v0, :cond_19
 
+    iget-object v0, v1, Lcom/android/server/pm/InstallPackageHelper;->mContext:Landroid/content/Context;
+
+    invoke-virtual {v0}, Landroid/content/Context;->getContentResolver()Landroid/content/ContentResolver;
+
+    move-result-object v0
+
+    const-string v15, "unica_allow_sdkbypass"
+
+    invoke-static {v0, v15, v8}, Landroid/provider/Settings$System;->getInt(Landroid/content/ContentResolver;Ljava/lang/String;I)I
+
+    move-result v0
+
+    if-eqz v0, :cond_unica_skip
+    goto :cond_19
+
+    :cond_unica_skip
+
     invoke-interface {v3}, Lcom/android/internal/pm/parsing/pkg/ParsedPackage;->getTargetSdkVersion()I
 
     move-result v0
