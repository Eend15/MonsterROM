Subject: [PATCH] Use QPR2 vsync frame scheduling while preserving Samsung EGL failure handling

diff --git a/smali/com/android/dreams/basic/ColorsGLRenderer.smali b/smali/com/android/dreams/basic/ColorsGLRenderer.smali
--- a/smali/com/android/dreams/basic/ColorsGLRenderer.smali
+++ b/smali/com/android/dreams/basic/ColorsGLRenderer.smali
@@ -772,13 +772,11 @@
     :cond_1
     invoke-direct {p0}, Lcom/android/dreams/basic/ColorsGLRenderer;->checkEglError()V
 
     iget-object p1, p0, Lcom/android/dreams/basic/ColorsGLRenderer;->mChoreographer:Landroid/view/Choreographer;
 
-    const-wide/16 v0, 0x19
-
-    invoke-virtual {p1, p0, v0, v1}, Landroid/view/Choreographer;->postFrameCallbackDelayed(Landroid/view/Choreographer$FrameCallback;J)V
+    invoke-virtual {p1, p0}, Landroid/view/Choreographer;->postFrameCallback(Landroid/view/Choreographer$FrameCallback;)V
 
     return-void
 .end method
 
 .method public setSize(II)V
