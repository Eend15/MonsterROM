Subject: [PATCH] Reject nonfinite coordinates and fractional subject Path verbs before publishing metadata

diff --git a/smali_classes2/android/hardware/camera2/impl/CameraMetadataNative.smali b/smali_classes2/android/hardware/camera2/impl/CameraMetadataNative.smali
--- a/smali_classes2/android/hardware/camera2/impl/CameraMetadataNative.smali
+++ b/smali_classes2/android/hardware/camera2/impl/CameraMetadataNative.smali
@@ -7197,6 +7197,8 @@
     return-object p0
 
     :cond_0
+    invoke-static {p0}, Landroid/hardware/camera2/impl/CameraMetadataNative;->validateSubjectPathFloats([F)V
+
     new-instance v0, Landroid/graphics/Path;
 
     invoke-direct {v0}, Landroid/graphics/Path;-><init>()V
@@ -7211,8 +7213,25 @@
 
     aget v3, p0, v1
 
+    move v5, v3
+
     float-to-int v3, v3
 
+    int-to-float v6, v3
+
+    cmpl-float v5, v5, v6
+
+    if-eqz v5, :unica_exact_subject_verb
+
+    new-instance p0, Ljava/lang/AssertionError;
+
+    const-string v0, "Malformed path verb"
+
+    invoke-direct {p0, v0}, Ljava/lang/AssertionError;-><init>(Ljava/lang/Object;)V
+
+    throw p0
+
+    :unica_exact_subject_verb
     const-string/jumbo v4, "Malformed path data"
 
     if-eqz v3, :cond_a
@@ -7724,9 +7743,46 @@
 
     move-result-object p1
 
+    invoke-static {p1}, Landroid/hardware/camera2/impl/CameraMetadataNative;->validateSubjectPathFloats([F)V
+
     sget-object v1, Landroid/hardware/camera2/CaptureResult;->EXTENSION_SUBJECT_SEGMENTATION_PATH_DATA:Landroid/hardware/camera2/CaptureResult$Key;
 
     invoke-direct {p0, v1, p1}, Landroid/hardware/camera2/impl/CameraMetadataNative;->setBase(Landroid/hardware/camera2/CaptureResult$Key;Ljava/lang/Object;)V
 
     return v0
 .end method
+
+.method private static blacklist validateSubjectPathFloats([F)V
+    .locals 3
+
+    const/4 v0, 0x0
+
+    array-length v1, p0
+
+    :unica_subject_float
+    if-ge v0, v1, :unica_subject_finite
+
+    aget v2, p0, v0
+
+    invoke-static {v2}, Ljava/lang/Float;->isFinite(F)Z
+
+    move-result v2
+
+    if-eqz v2, :unica_subject_nonfinite
+
+    add-int/lit8 v0, v0, 0x1
+
+    goto :unica_subject_float
+
+    :unica_subject_finite
+    return-void
+
+    :unica_subject_nonfinite
+    new-instance p0, Ljava/lang/AssertionError;
+
+    const-string v0, "Nonfinite path data"
+
+    invoke-direct {p0, v0}, Ljava/lang/AssertionError;-><init>(Ljava/lang/Object;)V
+
+    throw p0
+.end method
