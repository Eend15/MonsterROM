From: UN1CA contributors
Subject: [PATCH] Backport QPR2 app identity and raw certificate digest helpers

diff --git a/smali_classes3/android/os/Process.smali b/smali_classes3/android/os/Process.smali
--- a/smali_classes3/android/os/Process.smali
+++ b/smali_classes3/android/os/Process.smali
@@ -2046,3 +2046,40 @@
 
     throw p0
 .end method
+
+.method public static final whitelist areUidsForSameApplication(II)Z
+    .locals 1
+
+    invoke-static {p0}, Landroid/os/Process;->isPrivateComputeCoreUid(I)Z
+
+    move-result v0
+
+    if-eqz v0, :cond_0
+
+    invoke-static {p0}, Landroid/os/Process;->getAppUidForPrivateComputeCoreUid(I)I
+
+    move-result p0
+
+    :cond_0
+    invoke-static {p1}, Landroid/os/Process;->isPrivateComputeCoreUid(I)Z
+
+    move-result v0
+
+    if-eqz v0, :cond_1
+
+    invoke-static {p1}, Landroid/os/Process;->getAppUidForPrivateComputeCoreUid(I)I
+
+    move-result p1
+
+    :cond_1
+    if-ne p0, p1, :cond_2
+
+    const/4 p0, 0x1
+
+    return p0
+
+    :cond_2
+    const/4 p0, 0x0
+
+    return p0
+.end method
diff --git a/smali_classes4/android/util/PackageUtils.smali b/smali_classes4/android/util/PackageUtils.smali
--- a/smali_classes4/android/util/PackageUtils.smali
+++ b/smali_classes4/android/util/PackageUtils.smali
@@ -415,3 +415,54 @@
 
     return-object v0
 .end method
+
+.method public static blacklist toHexString([B)Ljava/lang/String;
+    .locals 1
+
+    if-nez p0, :cond_0
+
+    const/4 p0, 0x0
+
+    return-object p0
+
+    :cond_0
+    const/4 v0, 0x1
+
+    invoke-static {p0, v0}, Llibcore/util/HexEncoding;->encodeToString([BZ)Ljava/lang/String;
+
+    move-result-object p0
+
+    return-object p0
+.end method
+
+.method public static blacklist computeSignaturesSha256DigestsBytes([Landroid/content/pm/Signature;)[[B
+    .locals 4
+
+    array-length v0, p0
+
+    new-array v1, v0, [[B
+
+    const/4 v2, 0x0
+
+    :goto_0
+    if-ge v2, v0, :cond_0
+
+    aget-object v3, p0, v2
+
+    invoke-virtual {v3}, Landroid/content/pm/Signature;->toByteArray()[B
+
+    move-result-object v3
+
+    invoke-static {v3}, Landroid/util/PackageUtils;->computeSha256DigestBytes([B)[B
+
+    move-result-object v3
+
+    aput-object v3, v1, v2
+
+    add-int/lit8 v2, v2, 0x1
+
+    goto :goto_0
+
+    :cond_0
+    return-object v1
+.end method
