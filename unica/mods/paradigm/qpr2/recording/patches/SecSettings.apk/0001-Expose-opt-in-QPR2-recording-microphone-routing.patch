Subject: [PATCH] Expose the working QPR2 recorder route with a per-user off-by-default Samsung Sound setting

diff --git a/res/values-nl/unica_qpr2_recording_audio.xml b/res/values-nl/unica_qpr2_recording_audio.xml
new file mode 100644
--- /dev/null
+++ b/res/values-nl/unica_qpr2_recording_audio.xml
@@ -0,0 +1,5 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <string name="unica_qpr2_recording_bluetooth_title">Bluetooth-microfoon voor schermopnames</string>
+    <string name="unica_qpr2_recording_bluetooth_summary">Gebruik de voorkeursheadset, actieve headset of enige Bluetooth-headset. Bij twijfel of ontbrekende invoer blijft de normale microfoon behouden.</string>
+</resources>
diff --git a/res/values/unica_qpr2_recording_audio.xml b/res/values/unica_qpr2_recording_audio.xml
new file mode 100644
--- /dev/null
+++ b/res/values/unica_qpr2_recording_audio.xml
@@ -0,0 +1,5 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <string name="unica_qpr2_recording_bluetooth_title">Bluetooth microphone for screen recordings</string>
+    <string name="unica_qpr2_recording_bluetooth_summary">Use the preferred, active or sole Bluetooth headset. Ambiguous or unavailable inputs keep the normal microphone.</string>
+</resources>
diff --git a/res/xml/as_sound_vibration_settings_v2.xml b/res/xml/as_sound_vibration_settings_v2.xml
--- a/res/xml/as_sound_vibration_settings_v2.xml
+++ b/res/xml/as_sound_vibration_settings_v2.xml
@@ -22,6 +22,7 @@
     <androidx.preference.PreferenceCategory android:title="@string/sec_advance_sound_settings_subtitle" android:key="advanced_sound_category" />
     <SecPreferenceScreen android:persistent="false" android:title="@string/sec_sound_effect_title" android:key="sound_effect" settings:controller="com.samsung.android.settings.asbase.audio.SecSoundEffectSoundController" settings:keywords="@string/keywords_sound_and_vibrations_settings_sound_quality_and_effects" />
     <SecPreferenceScreen android:persistent="false" android:title="@string/sec_multi_sound_title" android:key="multi_sound" settings:controller="com.samsung.android.settings.asbase.audio.SecSoundMultiSoundController" />
     <com.samsung.android.settings.widget.SecInsetCategoryPreference android:key="work_sound_category" />
     <SecPreferenceScreen android:title="@string/sec_sound_work_settings" android:key="sound_work_settings" android:fragment="com.samsung.android.settings.asbase.work.SecSoundWorkSettings" settings:controller="com.samsung.android.settings.asbase.work.SecWorkSoundsPreferenceController" />
+    <SecSwitchPreference android:persistent="false" android:title="@string/unica_qpr2_recording_bluetooth_title" android:key="unica_qpr2_recording_bluetooth_mic" android:summary="@string/unica_qpr2_recording_bluetooth_summary" settings:controller="io.mesalabs.unica.recording.Qpr2RecordingAudioPreferenceController" />
 </PreferenceScreen>
