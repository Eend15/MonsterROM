Subject: [PATCH] Integrate QPR2 controlled wheel speed and reverse scrolling in Samsung mouse settings

diff --git a/res/values-nl/unica_qpr2_wheel.xml b/res/values-nl/unica_qpr2_wheel.xml
new file mode 100644
--- /dev/null
+++ b/res/values-nl/unica_qpr2_wheel.xml
@@ -0,0 +1,4 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <string name="unica_qpr2_controlled_scrolling_summary">Gebruik een vaste wielsnelheid in plaats van scrollversnelling</string>
+</resources>
diff --git a/res/values/public.xml b/res/values/public.xml
--- a/res/values/public.xml
+++ b/res/values/public.xml
@@ -49061,4 +49061,5 @@
     <public type="string" name="unica_qpr2_contrast_title" id="0x7f1544e1" />
     <public type="string" name="unica_qpr2_diagonal_summary" id="0x7f1544e2" />
     <public type="string" name="unica_qpr2_diagonal_title" id="0x7f1544e3" />
+    <public type="string" name="unica_qpr2_controlled_scrolling_summary" id="0x7f1544e4" />
 </resources>
diff --git a/res/values/unica_qpr2_wheel.xml b/res/values/unica_qpr2_wheel.xml
new file mode 100644
--- /dev/null
+++ b/res/values/unica_qpr2_wheel.xml
@@ -0,0 +1,4 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <string name="unica_qpr2_controlled_scrolling_summary">Use a fixed wheel speed instead of scrolling acceleration</string>
+</resources>
diff --git a/res/xml/sec_mouse_settings.xml b/res/xml/sec_mouse_settings.xml
--- a/res/xml/sec_mouse_settings.xml
+++ b/res/xml/sec_mouse_settings.xml
@@ -2,7 +2,9 @@
 <PreferenceScreen android:title="@string/sec_mouse_title" settings:hierarchicalParentFragment="com.samsung.android.settings.general.GeneralDeviceSettings" settings:topLevelPreferenceKey="top_level_general"
   xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto">
     <com.samsung.android.settings.inputmethod.SecPointerSpeedPreference android:title="@string/pointer_speed" android:key="pointer_speed" android:dialogTitle="@string/pointer_speed" settings:controller="com.android.settings.language.PointerSpeedController" />
-    <com.samsung.android.settings.inputmethod.SecMouseScrollingSpeedPreference android:title="@string/mouse_scrolling_speed" android:key="mouse_scrolling_speed" settings:controller="com.samsung.android.settings.inputmethod.SecMouseScrollingSpeedController" />
+    <SecSwitchPreference android:title="@string/mouse_reverse_vertical_scrolling" android:key="mouse_reverse_vertical_scrolling" android:summary="@string/mouse_reverse_vertical_scrolling_summary" settings:controller="com.android.settings.inputmethod.MouseReverseVerticalScrollingPreferenceController" />
+    <SecSwitchPreference android:title="@string/mouse_scrolling_acceleration" android:key="mouse_scrolling_acceleration" android:summary="@string/unica_qpr2_controlled_scrolling_summary" settings:controller="com.android.settings.inputmethod.MouseScrollingAccelerationPreferenceController" />
+    <com.android.settingslib.widget.SliderPreference android:title="@string/mouse_scrolling_speed" android:selectable="false" android:key="mouse_scrolling_speed" settings:controller="com.android.settings.inputmethod.MouseScrollingSpeedPreferenceController" settings:iconEnd="@drawable/ic_add_24dp" settings:iconEndContentDescription="@string/mouse_scrolling_speed_make_faster_description" settings:iconStart="@drawable/ic_remove_24dp" settings:iconStartContentDescription="@string/mouse_scrolling_speed_make_slower_description" settings:seekBarIncrement="1" />
     <SecSwitchPreference android:title="@string/mouse_enhance_pointer_precision_title" android:key="enhance_pointer_precision" settings:controller="com.samsung.android.settings.inputmethod.EnhancePointerPrecisionPreferenceController" />
     <SecPreference android:title="@string/mouse_pointer_size_and_color_title" android:key="mouse_pointer_settings" android:fragment="com.samsung.android.settings.inputmethod.MousePointerSettingsFragment" settings:controller="com.samsung.android.settings.inputmethod.MousePointerSettingsPreferenceController" />
     <com.samsung.android.settings.widget.SecInsetCategoryPreference />
