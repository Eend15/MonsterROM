-            <com.android.systemui.qs.bar.VolumeToggleSeekBar android:id="@id/slider" android:background="@null" android:layout_width="match_parent" android:layout_height="match_parent" android:progressDrawable="@drawable/sec_brightness_progress_gradient_drawable" android:thumb="@drawable/sec_qs_slider_thumb" android:layout_centerVertical="true" android:layout_alignParentStart="true" android:layout_alignParentEnd="true" android:splitTrack="false" />
+            <com.android.systemui.qs.bar.VolumeToggleSeekBar android:id="@id/slider" android:background="@null" android:layout_width="match_parent" android:layout_height="match_parent" android:progressDrawable="@drawable/sec_brightness_progress_gradient_drawable" android:thumb="@drawable/unica_glass_slider_thumb" android:paddingStart="44.0dp" android:paddingEnd="40.0dp" android:layout_centerVertical="true" android:layout_alignParentStart="true" android:layout_alignParentEnd="true" android:splitTrack="false" />
         </com.android.systemui.qs.bar.BrightnessVolumeRoundedView>
         <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true">
             <com.android.systemui.volume.view.icon.QPVolumeIcon android:layout_gravity="center_horizontal" android:id="@id/qs_volume_button" android:layout_width="32.0dp" android:layout_height="32.0dp" android:layout_centerVertical="true" android:contentDescription="@null" android:layout_marginStart="6.0dp" android:layout_alignParentStart="true" />
