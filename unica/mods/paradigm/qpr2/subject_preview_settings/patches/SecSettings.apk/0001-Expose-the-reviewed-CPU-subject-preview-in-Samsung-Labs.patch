+<resources>
+    <string name="unica_subject_preview_title">Subjectpad — CPU-proef</string>
+    <string name="unica_subject_preview_summary">Bekijk het Samsung-menssegmentatieresultaat op een lokaal gekozen foto. Geen live Camera2-extensie.</string>
+</resources>
