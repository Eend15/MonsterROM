Subject: [PATCH] Connect the QPR2 USB permission workflow to Samsung Connections using the existing allowlisted fragment

diff --git a/res/values-nl/unica_qpr2_usb_entry.xml b/res/values-nl/unica_qpr2_usb_entry.xml
new file mode 100644
--- /dev/null
+++ b/res/values-nl/unica_qpr2_usb_entry.xml
@@ -0,0 +1,5 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <string name="unica_qpr2_usb_access_title">USB-apparaten en app-toegang</string>
+    <string name="unica_qpr2_usb_access_summary">Bekijk verbonden USB-apparaten en trek app-toegang in</string>
+</resources>
diff --git a/res/values/unica_qpr2_usb_entry.xml b/res/values/unica_qpr2_usb_entry.xml
new file mode 100644
--- /dev/null
+++ b/res/values/unica_qpr2_usb_entry.xml
@@ -0,0 +1,5 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <string name="unica_qpr2_usb_access_title">USB devices and app access</string>
+    <string name="unica_qpr2_usb_access_summary">Review connected USB devices and remove app access</string>
+</resources>
diff --git a/res/xml/sec_connections_settings.xml b/res/xml/sec_connections_settings.xml
--- a/res/xml/sec_connections_settings.xml
+++ b/res/xml/sec_connections_settings.xml
@@ -40,7 +40,8 @@
         <intent android:action="com.samsung.android.app.telephonyui.action.OPEN_NET_SETTINGS">
             <extra android:name="root_key" android:value="T_GLOBAL_ROAMING" />
             <extra android:name="from_settings" android:value="true" />
         </intent>
     </SecPreferenceScreen>
+    <SecPreferenceScreen android:title="@string/unica_qpr2_usb_access_title" android:summary="@string/unica_qpr2_usb_access_summary" android:key="unica_qpr2_usb_access" android:order="2180" android:fragment="com.android.settings.connecteddevice.usb.UsbDetailsFragment" />
     <SecPreferenceScreen android:title="@string/more_connection_settings_title" android:key="wireless_settings" android:order="2200" android:fragment="com.samsung.android.settings.connection.WirelessSettings" settings:controller="com.samsung.android.settings.connection.MoreConnectionController" settings:keywords="@string/keywords_more_connection_settings" />
 </PreferenceScreen>
