Subject: [PATCH] Expose QPR2 diagonal panning using the existing Samsung SystemUI reader

diff --git a/res/values-nl/unica_qpr2_magnification.xml b/res/values-nl/unica_qpr2_magnification.xml
new file mode 100644
--- /dev/null
+++ b/res/values-nl/unica_qpr2_magnification.xml
@@ -0,0 +1,5 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <string name="unica_qpr2_diagonal_title">Diagonaal verschuiven toestaan</string>
+    <string name="unica_qpr2_diagonal_summary">Verplaats het vergrootglas ook diagonaal, naast horizontaal en verticaal.</string>
+</resources>
diff --git a/res/values/unica_qpr2_magnification.xml b/res/values/unica_qpr2_magnification.xml
new file mode 100644
--- /dev/null
+++ b/res/values/unica_qpr2_magnification.xml
@@ -0,0 +1,5 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <string name="unica_qpr2_diagonal_title">Allow diagonal panning</string>
+    <string name="unica_qpr2_diagonal_summary">Move the magnification window diagonally, as well as horizontally and vertically.</string>
+</resources>
diff --git a/res/xml/magnification.xml b/res/xml/magnification.xml
--- a/res/xml/magnification.xml
+++ b/res/xml/magnification.xml
@@ -19,4 +19,5 @@
     <SwitchPreference android:title="@string/sec_accessibility_magnification_cursor_following_title" android:key="accessibility_magnification_cursor_following_mode" settings:controller="com.samsung.android.settings.accessibility.vision.controllers.SecCursorFollowingModeSwitchPreferenceController" />
     <SeslPreferenceCaption android:title="@string/sec_accessibility_magnification_move_screen_summary" android:key="accessibility_magnification_description_preference" settings:controller="com.samsung.android.settings.accessibility.vision.controllers.MagnificationDescriptionPreferenceController" settings:searchable="false" />
     <com.samsung.android.settings.accessibility.base.widget.DescriptionPreference android:key="description_text_preference" settings:searchable="false" settings:showTopPadding="true" />
+    <SwitchPreference android:persistent="false" android:title="@string/unica_qpr2_diagonal_title" android:key="unica_qpr2_diagonal" android:summary="@string/unica_qpr2_diagonal_summary" settings:controller="io.mesalabs.unica.settings.Qpr2MagnificationPanningController" />
 </PreferenceScreen>
