Subject: [PATCH] Add the QPR2 three-level contrast choice to Samsung Display settings

diff --git a/res/values-nl/unica_qpr2_contrast.xml b/res/values-nl/unica_qpr2_contrast.xml
new file mode 100644
--- /dev/null
+++ b/res/values-nl/unica_qpr2_contrast.xml
@@ -0,0 +1,14 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <string name="unica_qpr2_contrast_title">Interfacecontrast</string>
+    <string-array name="unica_qpr2_contrast_entries">
+        <item>Standaard</item>
+        <item>Gemiddeld</item>
+        <item>Hoog</item>
+    </string-array>
+    <string-array name="unica_qpr2_contrast_values">
+        <item>0</item>
+        <item>1</item>
+        <item>2</item>
+    </string-array>
+</resources>
