From cf9b438bc847d171dcfd6b54cd2c134052e982b0 Mon Sep 17 00:00:00 2001
From: Salvo Giangreco <giangrecosalvo9@gmail.com>
Date: Fri, 17 Oct 2025 12:02:03 +0200
Subject: [PATCH] Enable real time network speed in status bar

---
diff --git a/smali_classes5/com/samsung/android/settings/eternal/provider/items/NotificationsItem.smali b/smali_classes5/com/samsung/android/settings/eternal/provider/items/NotificationsItem.smali
index 08ad43e..3cce293 100644
--- a/smali_classes5/com/samsung/android/settings/eternal/provider/items/NotificationsItem.smali
+++ b/smali_classes5/com/samsung/android/settings/eternal/provider/items/NotificationsItem.smali
@@ -509,22 +509,14 @@
 
     if-eqz v2, :cond_0
 
-    invoke-static {}, Lcom/samsung/android/feature/SemCscFeature;->getInstance()Lcom/samsung/android/feature/SemCscFeature;
-
-    move-result-object v0
-
-    const-string v2, "CscFeature_Common_SupportZProjectFunctionInGlobal"
-
-    const/4 v3, 0x0
-
-    invoke-virtual {v0, v2, v3}, Lcom/samsung/android/feature/SemCscFeature;->getBoolean(Ljava/lang/String;Z)Z
-
-    move-result v0
+    const/4 v0, 0x1
 
     if-eqz v0, :cond_1f
 
     const-string v0, "network_speed"
 
+    const/4 v3, 0x0
+
     invoke-static {v15, v0, v3}, Landroid/provider/Settings$System;->getInt(Landroid/content/ContentResolver;Ljava/lang/String;I)I
 
     move-result v0
@@ -2054,17 +2046,7 @@
 
     if-eqz v0, :cond_d
 
-    invoke-static {}, Lcom/samsung/android/feature/SemCscFeature;->getInstance()Lcom/samsung/android/feature/SemCscFeature;
-
-    move-result-object v0
-
-    const-string v2, "CscFeature_Common_SupportZProjectFunctionInGlobal"
-
-    const/4 v3, 0x0
-
-    invoke-virtual {v0, v2, v3}, Lcom/samsung/android/feature/SemCscFeature;->getBoolean(Ljava/lang/String;Z)Z
-
-    move-result v0
+    const/4 v0, 0x1
 
     if-eqz v0, :cond_4
 
diff --git a/smali_classes5/com/samsung/android/settings/notification/ConfigureNotificationMoreSettings$1.smali b/smali_classes5/com/samsung/android/settings/notification/ConfigureNotificationMoreSettings$1.smali
index 42924d1..5af28c3 100644
--- a/smali_classes5/com/samsung/android/settings/notification/ConfigureNotificationMoreSettings$1.smali
+++ b/smali_classes5/com/samsung/android/settings/notification/ConfigureNotificationMoreSettings$1.smali
@@ -37,17 +37,7 @@
     invoke-virtual {v1, v0}, Ljava/util/ArrayList;->add(Ljava/lang/Object;)Z
 
     :cond_1
-    invoke-static {}, Lcom/samsung/android/feature/SemCscFeature;->getInstance()Lcom/samsung/android/feature/SemCscFeature;
-
-    move-result-object v0
-
-    const-string v1, "CscFeature_Common_SupportZProjectFunctionInGlobal"
-
-    const/4 v2, 0x0
-
-    invoke-virtual {v0, v1, v2}, Lcom/samsung/android/feature/SemCscFeature;->getBoolean(Ljava/lang/String;Z)Z
-
-    move-result v0
+    const/4 v0, 0x1
 
     if-nez v0, :cond_2
 
diff --git a/smali_classes5/com/samsung/android/settings/notification/StatusBarNetworkSpeedController.smali b/smali_classes5/com/samsung/android/settings/notification/StatusBarNetworkSpeedController.smali
index 6908fdc..3868fb9 100644
--- a/smali_classes5/com/samsung/android/settings/notification/StatusBarNetworkSpeedController.smali
+++ b/smali_classes5/com/samsung/android/settings/notification/StatusBarNetworkSpeedController.smali
@@ -24,17 +24,7 @@
 .method static constructor <clinit>()V
     .locals 3
 
-    invoke-static {}, Lcom/samsung/android/feature/SemCscFeature;->getInstance()Lcom/samsung/android/feature/SemCscFeature;
-
-    move-result-object v0
-
-    const-string v1, "CscFeature_Common_SupportZProjectFunctionInGlobal"
-
-    const/4 v2, 0x0
-
-    invoke-virtual {v0, v1, v2}, Lcom/samsung/android/feature/SemCscFeature;->getBoolean(Ljava/lang/String;Z)Z
-
-    move-result v0
+    const/4 v0, 0x1
 
     sput-boolean v0, Lcom/samsung/android/settings/notification/StatusBarNetworkSpeedController;->SUPPORT_NETWORK_SPEED:Z
 
