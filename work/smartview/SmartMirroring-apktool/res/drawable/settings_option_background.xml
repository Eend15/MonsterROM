<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/settings_option_background_color" />
            <corners android:radius="@dimen/sliding_view_layout_conner_radius" />
        </shape>
    </item>
    <item android:bottom="@dimen/icon_view_stroke_layer">
        <shape android:shape="rectangle">
            <stroke android:width="@dimen/icon_view_stroke_width" android:color="@color/option_view_stroke_color" />
            <corners android:radius="@dimen/sliding_view_layout_conner_radius" />
        </shape>
    </item>
</layer-list>
