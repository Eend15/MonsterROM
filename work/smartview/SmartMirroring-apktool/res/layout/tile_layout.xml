<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:gravity="start|center" android:orientation="vertical" android:id="@id/allsharecast_tile_text_layout" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/tile_margin_side" android:layout_marginEnd="@dimen/tile_margin_side">
        <TextView android:theme="@style/device_default_light" android:textSize="@dimen/tile_text_size" android:textColor="@color/tile_description_text_color" android:gravity="start|center" android:id="@id/allsharecast_tile_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tile_view_description" android:fontFamily="sec-roboto-light" />
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:id="@id/allsharecast_tile_device_name_layout" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/tile_margin_side" android:layout_marginEnd="@dimen/tile_margin_side">
        <LinearLayout android:layout_gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textSize="@dimen/tile_connected_device_text_size" android:textStyle="bold" android:textColor="@color/tile_subheader_color" android:id="@id/allsharecast_tile_connected_device_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tile_connected_device" android:fontFamily="sec-roboto-light" />
            <ImageView android:layout_gravity="center_vertical" android:background="@drawable/subheader_divider" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginStart="@dimen/tile_subheader_divider_margin" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:id="@id/allsharecast_tile_mirroring_device" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/detail_settings_divider_margin_top" android:layout_marginBottom="@dimen/detail_settings_divider_margin_top">
            <RelativeLayout android:layout_gravity="center_vertical" android:layout_width="@dimen/tile_image_size" android:layout_height="@dimen/tile_image_size" android:layout_marginEnd="@dimen/tile_device_name_padding_start">
                <ImageView android:id="@id/allsharecast_tile_image" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:tint="@color/device_group_view_icon_tint" android:contentDescription="@null" />
                <ImageView android:id="@id/allsharecast_tile_cast_sub_icon" android:visibility="gone" android:layout_width="@dimen/device_child_view_cast_icon_size" android:layout_height="@dimen/device_child_view_cast_icon_size" android:layout_alignParentBottom="true" android:contentDescription="@null" android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <LinearLayout android:layout_gravity="center_vertical" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:textSize="@dimen/tile_device_name_text_size" android:textStyle="normal" android:textColor="@color/preference_title_connected_color" android:ellipsize="marquee" android:layout_gravity="center_vertical" android:id="@id/allsharecast_tile_device_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tile_connected_device_name" android:singleLine="true" android:fontFamily="sec-roboto-light" android:textDirection="locale" />
                <TextView android:textSize="@dimen/device_group_view_sub_text_size" android:textStyle="normal" android:textColor="@color/device_group_view_device_sub_text_color" android:ellipsize="end" android:layout_gravity="center_vertical" android:id="@id/tile_device_sub_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="10" android:fontFamily="sec-roboto-light" android:textDirection="locale" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
